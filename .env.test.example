# Copy to `.env.test` (`cp .env.test.example .env.test`) to run
# `pnpm test:integration` and `pnpm exec playwright test` locally or in CI.
# Loaded explicitly by vitest.integration.config.ts and playwright.config.ts
# — never by `pnpm dev`/`pnpm build`/`pnpm start`, which read `.env`.
#
# Points at a dedicated `holdria_test` database so integration and e2e
# tests never touch a developer's local `holdria` database or a
# production account. Create it once against the same PostgreSQL server
# `docker-compose.yml`'s `postgres` service runs (drizzle/roles.sql's
# roles already have privileges on any database on that server):
#
#   docker compose exec postgres createdb -U holdria holdria_test
#   MIGRATION_DATABASE_URL=postgresql://holdria_migrator:holdria_migrator_password@localhost:5432/holdria_test \
#     pnpm db:migrate

DATABASE_URL=postgresql://holdria_app:holdria_app_password@localhost:5432/holdria_test
MIGRATION_DATABASE_URL=postgresql://holdria_migrator:holdria_migrator_password@localhost:5432/holdria_test

# Playwright's webServer (playwright.config.ts) overrides BETTER_AUTH_URL
# and TRUSTED_ORIGINS to its own port (3100) at run time; the values below
# only matter for vitest integration tests, which construct Better Auth
# directly without a webServer.
BETTER_AUTH_SECRET=test-environment-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3100
TRUSTED_ORIGINS=http://localhost:3100

# Integration tests and Playwright never assert on delivered email content
# via SMTP (Better Auth callbacks are exercised directly, or the fixture
# marks the user verified in the database — see tests/integration/fixtures.ts
# and e2e/fixtures/db.ts), but SMTP_HOST/SMTP_PORT must still resolve for
# env validation and the SMTP transport construction to succeed. Mailpit
# from docker-compose.yml works and is harmless to actually send through.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@holdria.local
