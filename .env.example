# Copy this file to `.env` for local development (`cp .env.example .env`)
# and set a real BETTER_AUTH_SECRET. See `docs/deployment.md` for what
# every variable means in test, staging, and production, including which
# ones must change from these local-development defaults.
#
# Validated by src/config/env.ts at process startup — the app refuses to
# boot with a missing or malformed value instead of failing later.

# --- Database -----------------------------------------------------------
# Runtime connection: least-privilege DML role (see drizzle/roles.sql).
# Matches docker-compose.yml's `postgres` service and holdria_app role.
DATABASE_URL=postgresql://holdria_app:holdria_app_password@localhost:5432/holdria

# Migration-privileged connection (DDL), used only by `pnpm db:migrate` /
# `pnpm db:generate`, never by the running application. Falls back to
# DATABASE_URL when unset (not recommended outside local development,
# since that grants the running app DDL privileges).
MIGRATION_DATABASE_URL=postgresql://holdria_migrator:holdria_migrator_password@localhost:5432/holdria

# --- Better Auth ----------------------------------------------------------
# Secret used to sign sessions and tokens. Generate a real one per
# environment with `openssl rand -base64 32`; never reuse this value or
# share it between environments.
BETTER_AUTH_SECRET=change-me-to-a-random-32-character-or-longer-secret

# Public, canonical base URL the app is served at. Must be the exact
# origin users load in their browser (scheme + host + port), since Better
# Auth uses it for cookies and links in verification/reset email.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of origins allowed to call authenticated APIs.
# Include BETTER_AUTH_URL's origin and any other origin the app is served
# from (e.g. a bare domain and its www subdomain).
TRUSTED_ORIGINS=http://localhost:3000

# --- SMTP (verification, password reset, account-security email) -------
# Local development/tests point at the Mailpit service from
# docker-compose.yml, which captures mail instead of delivering it
# (web UI at http://localhost:8025). See docs/deployment.md for
# production SMTP configuration.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=no-reply@holdria.local

# --- Optional observability ----------------------------------------------
# Structured-logging/error-monitoring sink DSN. Unset disables it entirely
# (see docs/deployment.md, "Optional observability").
# OBSERVABILITY_DSN=

# --- Runtime ---------------------------------------------------------------
# Port the standalone Node.js server binds to. docker-compose.yml and the
# Dockerfile already set this inside the container; only needed here for
# `pnpm start`/`pnpm dev` on a non-default port.
PORT=3000
